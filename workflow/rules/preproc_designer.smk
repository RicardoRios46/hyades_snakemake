
rule prepare_inputs_designer:
    input:
        dwi = config['input_dwi'],
        bvec = config['input_bvec'],
        bval = config['input_bval'],
        b0_rpe = config['input_fmap']
    params: # TODO create rule to create ste and lte indexes from .ste
        lte_index = config['lte_index'],
        ste_index = config['ste_index']
    output:
        lte = temp('derivatives/designer-v2-preproc/sub-{subject}/dwi/input_designer/sub-{subject}_run-{run}_lte.mif'),
        ste = temp('derivatives/designer-v2-preproc/sub-{subject}/dwi/input_designer/sub-{subject}_run-{run}_ste.mif'),
        b0_rpe = temp('derivatives/designer-v2-preproc/sub-{subject}/dwi/input_designer/sub-{subject}_run-{run}_b0rpe.nii.gz')
    envmodules:
        config['mrtrix']
    shadow: "shallow"
    shell:
        """
        # Convert files to mif with dMRI metada so we dont worry about bval/bvecs
        mrconvert {input.dwi} working.mif -fslgrad {input.bvec} {input.bval} -force

        # Separate LTE/STE data from main file (the indexes includes 2 b0 for each block)
        mrconvert working.mif -coord 3 {params.lte_index} {output.lte} -force
        mrconvert working.mif -coord 3 {params.ste_index} {output.ste} -force

        # Copy rpe map to the input directory. Erase only read permissions
        cp --no-preserve=mode {input.b0_rpe} {output.b0_rpe}
        """


rule designer:
    input:
        lte = rules.prepare_inputs_designer.output.lte, # outputs from preparing data rule step
        ste = rules.prepare_inputs_designer.output.ste,
        b0_rpe =  rules.prepare_inputs_designer.output.b0_rpe
    params:
        pf = config['designer_pf'],
        echo_time = config['designer_echo_time'],
        echo_time_rpe = config['designer_echo_time_rpe'],
        pe_dir = config['designer_pe_dir']
    output: 
        dwi_preproc = "derivatives/designer-v2-preproc/sub-{subject}/dwi/sub-{subject}_acq-mde_run-{run}_desc-preproc_dwi.nii.gz",
        bvec_preproc = "derivatives/designer-v2-preproc/sub-{subject}/dwi/sub-{subject}_acq-mde_run-{run}_desc-preproc_dwi.bvec",
        bval_preproc = "derivatives/designer-v2-preproc/sub-{subject}/dwi/sub-{subject}_acq-mde_run-{run}_desc-preproc_dwi.bval",
        sigma = 'derivatives/designer-v2-preproc/sub-{subject}/dwi/sub-{subject}_run-{run}_sigmaNoise.nii.gz',
        brain_mask = 'derivatives/designer-v2-preproc/sub-{subject}/dwi/sub-{subject}_run-{run}_space-orig_desc-brain_mask.nii.gz'
    threads: workflow.cores
    resources:
        gpu = 1
    container:
        config['designer_container']
        #"docker://nyudiffusionmri/designer2:v2.0.4"
    #shadow: "shallow" # Didnt wokr because strange bug. Had to roll back to using tmp folder
    shell:
        """
        # Create tmp folder for output in /tmp
        output_folder={resources.tmpdir}/sub-{wildcards.subject}_output_designer/
        mkdir -p $output_folder

        designer \
        -denoise -rician \
        -degibbs -pf {params.pf} \
        -pre_align -ants_motion_correction \
        -eddy -rpe_pair {input.b0_rpe} -rpe_te {params.echo_time_rpe} -pe_dir {params.pe_dir} \
        -echo_time {params.echo_time},{params.echo_time} \
        -bshape 1,0 \
        -eddy_groups 1,2 \
        -mask \
        -scratch $output_folder/scratch_folder -nocleanup \
        {input.lte},{input.ste} \
        $output_folder/designer_dwi.mif

		# Copy output with metadata to correct outputpath and filenames
        mrconvert $output_folder/designer_dwi.mif {output.dwi_preproc} -export_grad_fsl {output.bvec_preproc} {output.bval_preproc}  -datatype int16 -force

        # Copy and compress sigma noise and brain_mask generated by designer into outputs files
        mrconvert $output_folder/scratch_folder/sigma.nii {output.sigma} -force
        mrconvert $output_folder/scratch_folder/brain_mask.nii {output.brain_mask} -force
            
        # Eraste tmp output folder
        rm -rf $output_folder
    #     """

# Preparing metadata to locate ste volumes
rule get_ste_metadata:
    input: 
        'supplemental_metadata/volumes_bool_postDesigner.ste'
    output:
        'derivatives/designer-v2-preproc/sub-{subject}/dwi/sub-{subject}_acq-mde_run-{run}_desc-preproc_dwi.ste'
    threads: 1
    shell:
        "cp {input} {output}"

# Get lte data an put into separate folder to keep thing clean
rule get_lte_data:
    input:
        dwi = rules.designer.output.dwi_preproc,
        bvec =  rules.designer.output.bvec_preproc,
        bval =  rules.designer.output.bval_preproc
    params:
        lte_index = config['lte_index_postDesigner']

    output: 
        lte_preproc = ("derivatives/designer-v2-preproc-lte/sub-{subject}/dwi/sub-{subject}_run-{run}_acq-lte_desc-preproc_dwi.nii.gz"),
        lte_bvec_preproc = ("derivatives/designer-v2-preproc-lte/sub-{subject}/dwi/sub-{subject}_run-{run}_acq-lte_desc-preproc_dwi.bvec"),
        lte_bval_preproc = ("derivatives/designer-v2-preproc-lte/sub-{subject}/dwi/sub-{subject}_run-{run}_acq-lte_desc-preproc_dwi.bval")
    envmodules:
        config['mrtrix'] 
    threads: workflow.cores
    shadow: "shallow"
    shell:
        """
        # Convert files to mif with dMRI metada so we dont worry about bval/bvecs
        mrconvert {input.dwi} working.mif -fslgrad {input.bvec} {input.bval} -force

        # Separate LTE data from main file (the indexes includes 4 b0)
        mrconvert working.mif -coord 3 {params.lte_index} -export_grad_fsl {output.lte_bvec_preproc} {output.lte_bval_preproc} {output.lte_preproc} -force
        """

# todo maybe use synth-strip seg to use same algorith for all masks
rule copy_mask_lte:
    input:
        rules.designer.output.brain_mask
    output: 
        ("derivatives/designer-v2-preproc-lte/sub-{subject}/dwi/sub-{subject}_run-{run}_space-orig_desc-brain_mask.nii.gz")
    threads: workflow.cores/4
    shell:
        """
        cp {input} {output}
        """


# B0 mean calculation
rule calc_b0mean_preproc:
    input:
        dwi = rules.designer.output.dwi_preproc,
        bvec =  rules.designer.output.bvec_preproc,
        bval =  rules.designer.output.bval_preproc
    output:
        'derivatives/designer-v2-preproc/sub-{subject}/dwi/sub-{subject}_run-{run}_b0mean.nii.gz'
    envmodules:
        config['mrtrix'] 
    threads: workflow.cores/2
    shell:
        "dwiextract -nthreads {threads} -fslgrad {input.bvec} {input.bval} -bzero {input.dwi} - | mrmath -nthreads {threads} - mean {output} -axis 3"